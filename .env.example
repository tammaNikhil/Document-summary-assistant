# Which summarization provider to use: groq | openai | anthropic
# Groq is the default — it has a genuinely free tier (no credit card).
SUMMARIZATION_PROVIDER=groq

# Only fill in the key for the provider you selected above.

# Free at https://console.groq.com/keys
GROQ_API_KEY=
# Current Groq default used by this app. Change if you want another
# supported Groq chat model: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Maximum upload size accepted, in megabytes.
# Vercel's free Hobby tier rejects request bodies over ~4.5MB at the
# platform level, before this app even sees them. Default is set to 4
# to stay safely under that. Raise it if you're on Vercel Pro or a
# different host. See README "Known limitations".
MAX_FILE_SIZE_MB=4
